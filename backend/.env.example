# Prysm LLM API Configurations
# Choose any ONE of the following API keys (Groq is recommended for free, ultra-fast generation!)

# 1. Groq (Recommended - 100% Free & extremely fast: Llama 3.3 70B Versatile)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini (Free tier with generous limits: Gemini 1.5 Flash / Pro)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OpenAI (GPT-4o-mini / GPT-4o)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
